/* .------------------------------------------------------------------------------------------------------------------------ */
.curve-linee {
  position: absolute;
  margin-top: 54.7px;
  left: 0;
  width: 100%;
  height: 120px;

  border-top: 4px solid transparent;
  border-radius: 150% / 200%;
  transform: translateY(-45%);

  /* Gradient border */
  border-image: linear-gradient(90deg, #ff003c, #ff0a37, #cd0202) 1;

  /* Glow */
  filter: drop-shadow(0 0 20px #ff0000)
          drop-shadow(0 0 20px #ff123e);
}
