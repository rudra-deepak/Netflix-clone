.slider {
    display: flex;
    gap: 55px;

    overflow-x: auto;   /* MUST for horizontal scroll */
    overflow-y: hidden; /* prevent vertical conflict */

    scroll-behavior: smooth;

    cursor: grab; /* nice UX */
}
.slider::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
}

.card{
    position: relative;
    flex: 0 0 auto;
    width: 200px;
    scroll-snap-align: start;
    border-radius: 8px;
    overflow: visible;
padding: 40px 10px;
  
}


.card img{
width: 100%;
height: 100%;
object-fit: cover;
display: block;
border-radius: 8px;

  /* Glow */
  filter: drop-shadow(0 0 10px #00eaff)
          drop-shadow(0 0 20px #4d62ff);
          transition: transform 0.3s ease;
}

/* When whole card is hovered */
.card:hover img {
    transform: scale(1.2);
}

.card:hover .number {
    transform: scale(1.1);
}


.number{
    position: absolute;
bottom: 45px;
left: -7px;
font-size: 89px;
font-weight: 800;
color: rgb(0, 0, 0);
-webkit-text-stroke: 0.25rem rgb(255, 255, 255);
 /* Glow */
  filter: drop-shadow(0 0 10px #d4ff00)
          drop-shadow(0 0 20px #4dff6e);
          transition: transform 0.3s ease;
  
}

